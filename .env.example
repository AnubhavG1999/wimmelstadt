# The names of the settings this project reads on the development machine.
# The real values go in .env.local, which is never committed.

# Supabase access token. Scripts on this machine use it to manage the backend.
# Created at https://supabase.com/dashboard/account/tokens
# Prefer a scoped token limited to the Wimmelstadt project.
SUPABASE_ACCESS_TOKEN=

# The Wimmelstadt project's reference ID: the code after /project/ in the
# Supabase dashboard's address. It is not a secret.
SUPABASE_PROJECT_REF=

# fal.ai key. The prototype's scripts use it to call the image-to-3D generators.
# Created at https://fal.ai/dashboard/keys
FAL_KEY=
